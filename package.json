{
  "name": "tfgm-platform-display-serverless",
  "version": "0.0.19",
  "description": "Serverless API backend for tfgm-platform-display",
  "type": "module",
  "scripts": {
    "deploy": "SLS_AWS_SDK=3 serverless deploy",
    "info": "SLS_AWS_SDK=3 serverless info",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "invoke:local": "bash scripts/invoke-all-local.sh",
    "invoke:deployed": "bash scripts/invoke-all-deployed.sh",
    "invoke:curl": "bash scripts/curl-all.sh",
    "check": "npm run lint && npm run typecheck && npm test && npm run invoke:local"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8",
    "@types/node": "^26",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "serverless": "^4.41.0",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "serverless@4.40.0": true
  }
}
